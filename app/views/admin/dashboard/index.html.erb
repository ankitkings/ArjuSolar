<h1>Dashboard</h1>
<% if @overdue.count.positive? %>
  <div class="alert-new">
    <h3>⚠ <%= pluralize(@overdue.count, "step") %> overdue<%= " – #{@overdue.high_count} high priority" if @overdue.high_count.positive? %></h3>
    <div class="table-wrap"><table>
      <tr><th>Priority</th><th>What</th><th>Overdue by</th><th>With</th><th></th></tr>
      <% @overdue.items.first(8).each do |i| %>
        <tr class="<%= 'new-request' if i.high? %>">
          <td><span class="badge <%= i.priority.downcase %>"><%= i.priority %></span></td>
          <td><%= i.title %><br><span class="muted small"><%= i.detail %></span></td>
          <td><b><%= time_ago_in_words(i.due_at) %></b></td>
          <td><%= i.owner %></td>
          <td><%= link_to "Open", overdue_item_path(i) %></td>
        </tr>
      <% end %>
    </table></div>
    <p><%= link_to "See all overdue steps →", admin_overdue_path %></p>
  </div>
<% end %>
<% if @new_requests.any? %>
  <div class="alert-new">
    <h3>🔔 <%= pluralize(@new_requests.size, "new request") %> not addressed yet</h3>
    <p class="small">Nobody has contacted these clients yet. The oldest has been waiting <b><%= time_ago_in_words(@new_requests.first.created_at) %></b>.</p>
    <div class="table-wrap"><table>
      <tr><th>Client</th><th>Phone</th><th>Waiting</th><th>Assigned to</th><th></th></tr>
      <% @new_requests.first(8).each do |r| %>
        <tr>
          <td><b><%= r.name %></b></td><td><%= r.phone %></td>
          <td class="<%= 'overdue' if r.created_at < 24.hours.ago %>"><%= time_ago_in_words(r.created_at) %><%= " – overdue" if r.created_at < 24.hours.ago %></td>
          <td><%= r.team_member&.name || "Nobody yet" %></td>
          <td><%= link_to "Open", admin_service_request_path(r) %></td>
        </tr>
      <% end %>
    </table></div>
    <p><%= link_to "See all #{@new_requests.size} new requests →", admin_service_requests_path(status: "pending") %>
      <%= " (showing the 8 oldest)" if @new_requests.size > 8 %></p>
  </div>
<% else %>
  <div class="all-clear">✅ All new requests have been addressed.</div>
<% end %>
<div class="stats">
  <div class="stat"><b><%= @visits_total %></b><span>Total visits</span></div>
  <div class="stat"><b><%= @visits_today %></b><span>Visits today</span></div>
  <div class="stat"><b><%= @unique_visitors %></b><span>Unique visitors (IP)</span></div>
  <div class="stat"><b><%= @requests_total %></b><span>Requests</span></div>
</div>
<div class="stats">
  <%= link_to admin_my_tasks_path, class: "stat #{'alert' if new_task_count.positive?}" do %><b><%= admin_task_count %></b><span>My tasks<%= " (#{new_task_count} new)" if new_task_count.positive? %></span><% end %>
  <%= link_to admin_attendance_path, class: "stat" do %><b><%= @present_today %> / <%= @team_total %></b><span>Present today</span><% end %>
  <%= link_to admin_leave_requests_path(status: "pending"), class: "stat #{'alert' if pending_leave_count.positive?}" do %><b><%= pending_leave_count %></b><span>Leave requests to decide</span><% end %>
  <%= link_to admin_overdue_path, class: "stat #{'alert' if @overdue.count.positive?}" do %><b><%= @overdue.count %></b><span>Overdue steps<%= " (#{@overdue.high_count} high)" if @overdue.high_count.positive? %></span><% end %>
  <%= link_to admin_service_requests_path(status: "pending"), class: "stat #{'alert' if @new_requests.any?}" do %><b><%= @new_requests.size %></b><span>New requests (not addressed)</span><% end %>
  <%= link_to admin_service_requests_path(unassigned: 1), class: "stat" do %><b><%= @unassigned %></b><span>Unassigned requests</span><% end %>
  <%= link_to admin_service_requests_path(with_admin: 1), class: "stat #{'alert' if @with_admin.positive?}" do %><b><%= @with_admin %></b><span>With the Admin (subsidy steps)</span><% end %>
  <%= link_to admin_stock_path(tab: "order"), class: "stat #{'alert' if parts_short_count.positive?}" do %><b><%= parts_short_count %></b><span>Parts to order today</span><% end %>
  <%= link_to admin_maintenance_visits_path, class: "stat" do %><b><%= @maintenance_due %></b><span>Maintenance due (7 days)</span><% end %>
  <%= link_to admin_payments_path, class: "stat" do %><b><%= @payments_pending %></b><span>Payments pending (<%= inr(@outstanding) %> outstanding)</span><% end %>
</div>
<h2>PM Surya Ghar subsidy – what needs you</h2>
<% if @subsidy_open.empty? %>
  <div class="all-clear">✅ No subsidy application is waiting for action.</div>
<% else %>
  <p class="tabs">
    <% SubsidyApplication::GROUP_STATUSES["in_progress"].each do |st| %>
      <%= link_to admin_subsidy_applications_path(status: st), class: "tab" do %><%= SubsidyApplication::LABELS[st] %> <b><%= @subsidy_counts[st].to_i %></b><% end %>
    <% end %>
  </p>
  <div class="table-wrap"><table>
    <tr><th>Client</th><th>Status</th><th>What to do next</th><th>Documents</th><th>Waiting</th><th></th></tr>
    <% @subsidy_open.first(8).each do |a| %>
      <% req = a.service_request %>
      <tr class="<%= 'new-request' if req.assigned_to_admin? %>">
        <td><%= link_to req.name, admin_service_request_path(req) %><%= " ⏳ job on hold" if req.assigned_to_admin? %></td>
        <td><span class="badge <%= a.status %>"><%= a.status_label %></span></td>
        <td><%= a.next_step %></td>
        <td><%= a.collected_documents.size %> of <%= SubsidyApplication::DOCUMENTS.size %></td>
        <td><%= time_ago_in_words(a.updated_at) %></td>
        <td><%= link_to "Open", admin_subsidy_application_path(a) %></td>
      </tr>
    <% end %>
  </table></div>
  <p><%= link_to "All subsidy applications →", admin_subsidy_applications_path %></p>
<% end %>

<h2>Requests by status</h2>
<div class="stats">
  <% ServiceRequest::STATUSES.each do |s| %>
    <%= link_to admin_service_requests_path(status: s), class: "stat small" do %>
      <b><%= @by_status[s].to_i %></b><span><%= s.humanize %></span>
    <% end %>
  <% end %>
</div>
<h2>Latest requests</h2>
<%= render "admin/service_requests/table", requests: @recent %>
