<h1>Overdue steps</h1>
<p class="muted">Anything that has stayed in a step longer than it should. High priority = it has taken twice as long as allowed (or a planned date was missed).</p>
<% items = @overdue.items %>
<% if items.empty? %>
  <div class="all-clear">✅ Nothing is overdue.</div>
<% else %>
  <div class="table-wrap"><table>
    <tr><th>Priority</th><th>What</th><th>Details</th><th>Overdue by</th><th>With</th><th></th></tr>
    <% items.each do |i| %>
      <tr class="<%= 'new-request' if i.high? %>">
        <td><span class="badge <%= i.priority.downcase %>"><%= i.priority %></span></td>
        <td><%= i.title %></td>
        <td><%= i.detail %></td>
        <td><b><%= time_ago_in_words(i.due_at) %></b></td>
        <td><%= i.owner %></td>
        <td><%= link_to "Open", overdue_item_path(i) %></td>
      </tr>
    <% end %>
  </table></div>
<% end %>

<h2>How long each step may take</h2>
<p class="muted small">A step is overdue when it takes longer than this many days. Change a number and save. It becomes high priority when it has taken twice as long.</p>
<% limits = OverdueLimit.all_limits %>
<%= form_with url: admin_overdue_limits_path, method: :patch do %>
  <div class="table-wrap"><table>
    <tr><th>Step</th><th class="right">Allowed days</th></tr>
    <% OverdueSteps.defaults.each do |key, standard| %>
      <tr>
        <td><%= OverdueSteps.label_for(key) %></td>
        <td class="right">
          <%= number_field_tag "limits[#{key}]", limits[key], min: 1, max: 365, step: 1, style: "width:90px" %>
          <% if limits[key] != standard %><span class="muted small">(standard: <%= standard %>)</span><% end %>
        </td>
      </tr>
    <% end %>
  </table></div>
  <p><%= submit_tag "Save days", class: "btn go" %></p>
<% end %>
<%= button_to "Back to the standard days", admin_overdue_limits_path, method: :delete, class: "btn hold",
      form: { onsubmit: "return confirm('Put every step back to the standard days?')" } %>
