<p><%= link_to "← Team", admin_team_members_path %></p>
<h1><%= @member.name %> <span class="muted" style="font-size:1rem">· <%= @member.department_label %></span></h1>
<p class="muted">
  <%= @member.phone.presence || "No phone" %> ·
  <%= @member.email.presence || "No login email" %> ·
  <%= @member.can_login? ? "Can log in" : "Cannot log in" %> ·
  <%= link_to "Edit", edit_admin_team_member_path(@member) %>
</p>

<div class="stats">
  <%= link_to admin_team_member_path(@member, filter: "open"), class: "stat" do %><b><%= @counts["open"] %></b><span>Open tasks</span><% end %>
  <%= link_to admin_team_member_path(@member, filter: "completed"), class: "stat" do %><b><%= @counts["completed"] %></b><span>Completed</span><% end %>
  <%= link_to admin_team_member_path(@member, filter: "all"), class: "stat" do %><b><%= @counts["all"] %></b><span>All assigned</span><% end %>
  <% if @member.department == "cashier" %>
    <div class="stat"><b><%= inr(@to_collect_total) %></b><span>Payments to collect (<%= @to_collect.size %>)</span></div>
  <% end %>
</div>

<h2><%= @filter.humanize %> tasks</h2>
<div class="table-wrap"><table>
  <tr><th>#</th><th>Customer</th><th>Phone</th><th>Status</th><th>Progress</th><th>Received</th><th>Last update</th><th></th></tr>
  <% @tasks.each do |t| %>
    <tr>
      <td><%= t.id %></td><td><%= t.name %></td><td><%= t.phone %></td>
      <td><span class="badge <%= t.status %>"><%= t.status_label %></span></td>
      <td><%= progress_bar(t) %></td>
      <td><%= l t.created_at, format: :short %></td>
      <td><%= l t.updated_at, format: :short %></td>
      <td><%= link_to "Open", admin_service_request_path(t) %></td>
    </tr>
  <% end %>
  <% if @tasks.empty? %><tr><td colspan="8" class="muted">No tasks here.</td></tr><% end %>
</table></div>

<h2>Recent activity by <%= @member.name %></h2>
<ul class="timeline">
  <% @activity.each do |u| %>
    <li>
      <b><%= u.status&.humanize %></b> · <%= u.progress %>% on
      <%= link_to "request ##{u.service_request_id} (#{u.service_request.name})", admin_service_request_path(u.service_request) %>
      <span class="muted"><%= l u.created_at, format: :short %></span>
      <% if u.note.present? %><br><%= u.note %><% end %>
    </li>
  <% end %>
  <% if @activity.empty? %><li class="muted">No updates made by this member yet.</li><% end %>
</ul>

<% if @visits.any? %>
  <h2>Maintenance visits</h2>
  <div class="table-wrap"><table>
    <tr><th>Customer</th><th>Visit</th><th>Due</th><th>Status</th><th></th></tr>
    <% @visits.each do |v| %>
      <tr><td><%= v.service_request.name %></td><td><%= v.title %></td><td><%= l v.due_on, format: :short %></td>
          <td><span class="badge <%= v.status %>"><%= v.status.humanize %></span></td>
          <td><%= link_to "Open", admin_service_request_path(v.service_request) %></td></tr>
    <% end %>
  </table></div>
<% end %>

<% if @member.department == "cashier" || @to_collect.any? || @collected.any? %>
  <h2>Payments to collect</h2>
  <p class="muted">Money <%= @member.name %> still has to collect from clients (installations already completed).</p>
  <div class="table-wrap"><table>
    <tr><th>Client</th><th>Request</th><th>Phone</th><th>System</th><th>Due</th><th>Paid</th><th>Balance to collect</th><th>Status</th><th></th></tr>
    <% @to_collect.each do |p| %>
      <% req = p.service_request %>
      <tr>
        <td><%= req.name %></td>
        <td><%= link_to "##{req.id}", admin_service_request_path(req) %></td>
        <td><%= req.phone %></td>
        <td><%= req.installation&.solar_package&.name || "—" %></td>
        <td><%= inr(p.amount_due) %></td>
        <td><%= inr(p.amount_paid) %></td>
        <td><b><%= inr(p.balance) %></b></td>
        <td><span class="badge <%= p.status %>"><%= p.status.humanize %></span></td>
        <td><%= link_to "Open", admin_payment_path(p) %></td>
      </tr>
    <% end %>
    <% if @to_collect.empty? %>
      <tr><td colspan="9" class="muted">Nothing to collect right now.</td></tr>
    <% else %>
      <tr><td colspan="6"><b>Total to collect</b></td><td><b><%= inr(@to_collect_total) %></b></td><td colspan="2"></td></tr>
    <% end %>
  </table></div>

  <h2>Payments collected</h2>
  <div class="table-wrap"><table>
    <tr><th>Client</th><th>Request</th><th>Total received</th><th>Receipts</th><th></th></tr>
    <% @collected.each do |p| %>
      <tr>
        <td><%= p.service_request.name %></td>
        <td><%= link_to "##{p.service_request_id}", admin_service_request_path(p.service_request) %></td>
        <td><%= inr(p.amount_paid) %></td>
        <td><%= p.receipts.map(&:number).join(", ").presence || "—" %></td>
        <td><%= link_to "Open", admin_payment_path(p) %></td>
      </tr>
    <% end %>
    <% if @collected.empty? %><tr><td colspan="5" class="muted">No fully paid payments yet.</td></tr><% end %>
  </table></div>
<% end %>
