<h1>Change the owner password</h1>
<div class="panel" style="max-width:520px">
  <%= form_with url: admin_owner_password_path, method: :patch, class: "form" do %>
    <%= label_tag :current_password, "Current owner password" %><%= password_field_tag :current_password, nil, required: true, autocomplete: "current-password" %>
    <%= label_tag :password, "New owner password (at least 8 characters)" %><%= password_field_tag :password, nil, required: true, minlength: 8, autocomplete: "new-password" %>
    <%= label_tag :password_confirmation, "Type the new password again" %><%= password_field_tag :password_confirmation, nil, required: true, autocomplete: "new-password" %>
    <%= submit_tag "Change the password", class: "btn go" %>
  <% end %>
</div>
