<% sr = @service_request %>
<p><%= link_to "← All requests", admin_service_requests_path %></p>
<h1>Request #<%= sr.id %> — <%= sr.name %></h1>
<div class="actions no-print" style="margin-bottom:12px">
  <%= link_to "Edit client details", edit_details_admin_service_request_path(sr), class: "btn hold" %>
  <%= button_to "Delete this request", admin_service_request_path(sr), method: :delete, class: "btn stop",
        form: { onsubmit: "return confirm(#{delete_request_warning(sr).to_json})" } %>
</div>
<div class="two-col">
  <div class="panel">
    <h3>Customer</h3>
    <p><strong>Phone:</strong> <%= link_to sr.phone, "tel:#{sr.phone.gsub(/[^\d+]/, '')}" %></p>
    <p><strong>Email:</strong> <%= sr.email.presence || "—" %></p>
    <p><strong>Address:</strong> <%= sr.address.presence || "—" %></p>
    <p><strong>IP:</strong> <%= sr.ip_address || "—" %></p>
    <p><strong>Received:</strong> <%= l sr.created_at, format: :long %></p>
    <p><strong>Message:</strong><br><%= simple_format(h(sr.message)) %></p>
  </div>
  <div class="panel <%= 'cancelled' if sr.status == 'cancelled' %>">
    <h3>Stage &amp; assignment</h3>
    <% if sr.errors.any? %><div class="flash alert"><%= sr.errors.full_messages.to_sentence %></div><% end %>
    <%= progress_bar(sr, big: true) %>
    <p class="<%= 'cancel-text' if sr.status == 'cancelled' %>"><span class="badge <%= sr.status %>"><%= sr.status_label %></span> <%= sr.progress %>%<%= sr.status == "cancelled" ? " – deal cancelled" : " complete" %></p>
    <p class="muted small">
      Stage owner: <b><%= sr.stage_department_label || "—" %></b>.
      Moving a request to a new stage automatically assigns the least busy active member of that department.
    </p>
    <%= form_with model: sr, url: admin_service_request_path(sr), method: :patch, class: "form" do |f| %>
      <% if sr.status == "completed" %>
        <p><b>Completed</b></p>
      <% else %>
        <%= f.label :status, "Move to stage (admin override)" %>
        <%= f.select :status, (ServiceRequest::STATUSES - (sr.status == "commissioning" ? [] : ["completed"])).map { |s| [s.humanize, s] } %>
      <% end %>
      <%= f.label :team_member_id, "Assigned to" %>
      <%= f.select :team_member_id, team_member_options(sr), include_blank: "Unassigned" %>
      <p class="muted small">Sorted by workload – the person with the fewest active tasks is first in each department.</p>
      <%= label_tag :note, "Note" %>
      <%= text_area_tag :note, nil, rows: 2 %>
      <%= f.submit "Save", class: "btn" %>
    <% end %>
  </div>
</div>

<% if sr.status == "installation" %>
  <div class="panel" style="margin-top:16px">
    <h3>Installation done? Enter the system details and add site photos (sends the request to payment)</h3>
    <%= render "shared/installation_form", installation: @installation, url: complete_admin_service_request_path(sr) %>
  </div>
<% end %>

<% if sr.installation&.persisted? %>
  <div class="two-col" style="margin-top:16px">
    <div class="panel">
      <%= render "shared/installation_summary", installation: sr.installation %>
      <hr>
      <h3>Website</h3>
      <%= form_with model: sr.installation, url: admin_installation_path(sr.installation), method: :patch, class: "form" do |f| %>
        <%= f.label :public_location, "Location shown on the website" %><%= f.text_field :public_location %>
        <label><%= f.check_box :show_on_website %> Show this project and its photos on the website</label>
        <%= f.submit "Save", class: "btn hold" %>
      <% end %>
    </div>
    <div class="panel">
      <h3>Follow-ups</h3>
      <% pay = sr.payment %>
      <p><strong>Payment:</strong>
        <% if pay.nil? %>—
        <% else %>
          <span class="badge <%= pay.status %>"><%= pay.status.humanize %></span>
          due <%= inr(pay.amount_due) %> · paid <%= inr(pay.amount_paid) %> · balance <%= inr(pay.balance) %>
          · <%= link_to "Open payment", admin_payment_path(pay) %>
        <% end %>
      </p>
      <p><strong>Maintenance:</strong></p>
      <ul class="timeline">
        <% sr.maintenance_visits.each do |v| %>
          <li><%= v.title %> — <%= l v.due_on, format: :short %>
            <span class="badge <%= v.status %>"><%= v.status.humanize %></span>
            <%= "· #{v.team_member.name}" if v.team_member %>
            <% if v.report.present? %><br><span class="muted"><%= v.report %></span><% end %>
          </li>
        <% end %>
      </ul>
      <%= link_to "Manage maintenance dates", admin_maintenance_visits_path(filter: "all") %>
    </div>
  </div>
<% end %>

<%= render "admin/subsidy_applications/panel", sr: sr %>

<% if sr.quotes.any? %>
  <h2>Quotes</h2>
  <div class="table-wrap"><table>
    <tr><th>Quote no.</th><th>System</th><th>Price</th><th>Discount</th><th>Total</th><th>Valid until</th><th>Status</th><th>By</th><th></th></tr>
    <% sr.quotes.includes(:team_member).each do |q| %>
      <tr><td><%= q.number %></td><td><%= q.system_name %></td><td><%= inr(q.list_price) %></td>
          <td><%= q.discount.positive? ? inr(q.discount) : "—" %></td><td><b><%= inr(q.total) %></b></td>
          <td><%= l q.valid_until, format: :short %></td>
          <td><span class="badge <%= q.status %>"><%= q.status.humanize %></span></td>
          <td><%= q.team_member&.name || "—" %></td>
          <td><%= link_to "View / print", admin_quote_path(q) %></td></tr>
    <% end %>
  </table></div>
<% end %>

<h2>Timeline</h2>
<ul class="timeline">
  <% sr.updates.includes(:admin_user, :team_member).each do |u| %>
    <li>
      <b><%= u.status&.humanize %></b> · <%= u.progress %>%
      <span class="muted"><%= l u.created_at, format: :short %><%= " by #{u.author_name}" if u.author_name %></span>
      <% if u.note.present? %><br><%= u.note %><% end %>
    </li>
  <% end %>
</ul>
