<div class="table-wrap"><table>
  <tr><th>#</th><th>Name</th><th>Phone</th><th>Status</th><th>Progress</th><th>Assigned</th><th>Received</th><th></th></tr>
  <% requests.each do |r| %>
    <tr>
      <td><%= r.id %></td><td><%= r.name %></td><td><%= r.phone %></td>
      <td><span class="badge <%= r.status %>"><%= r.status_label %></span></td>
      <td><div class="bar"><i style="width:<%= r.progress %>%"></i></div> <%= r.progress %>%</td>
      <td><%= r.team_member&.name || "—" %></td>
      <td><%= l r.created_at, format: :short %></td>
      <td><%= link_to "Open", admin_service_request_path(r) %></td>
    </tr>
  <% end %>
  <% if requests.empty? %><tr><td colspan="8" class="muted">No requests yet.</td></tr><% end %>
</table></div>
