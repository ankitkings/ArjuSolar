<%# New-task alert for the admin: a pop-up, a short beep and a badge, on every admin page %>
<div id="task-toasts" class="chat-toasts" aria-live="polite"></div>
<style>
  .chat-toasts{position:fixed;right:16px;bottom:16px;display:flex;flex-direction:column;gap:8px;z-index:50}
  .chat-toast{display:block;background:#0f172a;color:#fff;border-radius:10px;padding:10px 14px;max-width:320px;text-decoration:none;box-shadow:0 4px 16px rgba(0,0,0,.25)}
  .chat-toast b{display:block}.chat-toast span{opacity:.85;font-size:.9rem;word-break:break-word}
  @media(max-width:800px){.chat-toasts{left:12px;right:12px}.chat-toast{max-width:none}}
</style>
<script>
  (function () {
    var KEY = "adminTaskAlertAt";
    var badge = document.getElementById("my-tasks-badge");

    function beep() {
      try {
        var Ctx = window.AudioContext || window.webkitAudioContext;
        if (!Ctx) return;
        var ctx = new Ctx(), osc = ctx.createOscillator(), gain = ctx.createGain();
        osc.type = "sine"; osc.frequency.value = 660; gain.gain.value = 0.08;
        osc.connect(gain); gain.connect(ctx.destination);
        osc.start(); osc.stop(ctx.currentTime + 0.18);
        setTimeout(function () { ctx.close(); }, 500);
      } catch (e) {}
    }

    function toast(task) {
      var box = document.getElementById("task-toasts");
      var a = document.createElement("a");
      a.className = "chat-toast"; a.href = "<%= admin_my_tasks_path %>";
      var title = document.createElement("b"); title.textContent = "🔔 New task: " + task.title;
      var text = document.createElement("span"); text.textContent = task.detail;
      a.appendChild(title); a.appendChild(text);
      box.appendChild(a);
      setTimeout(function () { a.remove(); }, 10000);
    }

    function check() {
      fetch("<%= admin_my_tasks_alert_path %>", { headers: { "Accept": "application/json" }, credentials: "same-origin" })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d) return;
          if (badge) { badge.textContent = d.new_count + " new"; badge.style.display = d.new_count > 0 ? "inline" : "none"; }
          if (d.newest && d.newest.at > (localStorage.getItem(KEY) || "")) {   // only once per new task
            localStorage.setItem(KEY, d.newest.at);
            toast(d.newest);
            beep();
          }
        })
        .catch(function () {});
    }
    check();
    setInterval(check, 30000);
  })();
</script>
