<% packages = SolarPackage.available.includes(package_items: :catalog_item) %>
<% catalog = CatalogItem.available.to_a %>
<% catalog_data = catalog.to_h { |c| [c.id, { name: c.name, cat: c.category, price: c.unit_price.to_f, unit: c.unit }] } %>
<% if quote.errors.any? %><div class="flash alert"><%= quote.errors.full_messages.to_sentence %></div><% end %>
<% if packages.empty? %>
  <p class="muted">No systems are set up yet. Ask the admin to add them (with prices) under Admin → Systems.</p>
<% else %>
  <%= form_with model: quote, url: url, method: :post, class: "form" do |f| %>
    <%= f.label :solar_package_id, "System (from the price list)" %>
    <%= f.select :solar_package_id,
          options_for_select(packages.map { |p|
            parts = p.package_items.map { |pi| { name: pi.catalog_item.name, qty: pi.quantity.to_f, unit: pi.catalog_item.unit, price: pi.catalog_item.unit_price.to_f } }
            [p.label, p.id, { "data-price" => p.price.to_s, "data-details" => p.details, "data-parts" => parts.to_json }]
          }, quote.solar_package_id),
          { include_blank: "Select a system…" }, { required: true, id: "quote_solar_package_id" } %>
    <p id="quote-preview" class="muted small"></p>
    <div class="table-wrap" id="quote-parts" style="display:none"></div>

    <h4>Extra parts (optional)</h4>
    <p class="muted small">Add anything the client wants on top of this system, for example a battery. The price is added to the quote.</p>
    <div class="actions">
      <% if catalog.any? { |c| c.category == "battery" } %>
        <button type="button" class="btn hold add-extra" data-cat="battery">+ Battery</button>
      <% end %>
      <button type="button" class="btn hold add-extra" data-cat="">+ Another part</button>
    </div>
    <div class="table-wrap" id="extras-box" style="display:none"><table class="stack">
      <thead><tr><th>Part</th><th>Quantity</th><th class="right">Unit price</th><th class="right">Amount</th><th></th></tr></thead>
      <tbody id="extras-body"></tbody>
    </table></div>

    <%= f.label :discount, "Discount (₹, optional)" %>
    <%= f.number_field :discount, step: 0.01, min: 0, value: (quote.discount.to_f.positive? ? quote.discount : nil), id: "quote_discount" %>
    <label><%= f.check_box :subsidy_applies %> Home (residential) – government subsidy (PM Surya Ghar) applies</label>
    <%= f.label :valid_until, "Quote valid until" %>
    <%= f.date_field :valid_until, value: (quote.valid_until || Date.current + Quote::DEFAULT_VALIDITY_DAYS), min: Date.current, required: true %>
    <%= f.label :notes, "Notes for the client (optional)" %><%= f.text_area :notes, rows: 2 %>
    <%= f.submit "Create quote", class: "btn go" %>
  <% end %>

  <template id="extra-row-template">
    <tr>
      <td data-label="Part"><select name="extras[][catalog_item_id]" class="extra-select" required></select></td>
      <td data-label="Quantity"><input type="number" name="extras[][quantity]" class="extra-qty" value="1" min="0.01" step="0.01" style="width:90px" required></td>
      <td class="right extra-price" data-label="Unit price">—</td>
      <td class="right extra-line" data-label="Amount">₹0</td>
      <td data-label=""><button type="button" class="linklike extra-remove">Remove</button></td>
    </tr>
  </template>

  <script>
    (function () {
      var CATALOG = <%= raw json_escape(catalog_data.to_json) %>;
      var CATEGORIES = <%= raw json_escape(CatalogItem::CATEGORIES.to_json) %>;
      var sel = document.getElementById("quote_solar_package_id");
      var disc = document.getElementById("quote_discount");
      var box = document.getElementById("quote-preview");
      var partsBox = document.getElementById("quote-parts");
      var extrasBody = document.getElementById("extras-body");
      var extrasBox = document.getElementById("extras-box");
      var tpl = document.getElementById("extra-row-template");

      function inr(n) { return "₹" + Number(n).toLocaleString("en-IN", { maximumFractionDigits: 2 }); }
      function cell(row, text, right) { var td = document.createElement("td"); td.textContent = text; if (right) td.className = "right"; row.appendChild(td); return td; }

      function systemParts() {
        var o = sel.options[sel.selectedIndex];
        return (o && o.dataset.parts) ? JSON.parse(o.dataset.parts) : null;
      }

      // the extra parts chosen so far
      function extraParts() {
        var list = [];
        extrasBody.querySelectorAll("tr").forEach(function (tr) {
          var item = CATALOG[tr.querySelector(".extra-select").value];
          var qty = parseFloat(tr.querySelector(".extra-qty").value) || 0;
          if (item) list.push({ name: item.name, qty: qty, unit: item.unit, price: item.price });
        });
        return list;
      }

      function total() {
        var parts = (systemParts() || []).concat(extraParts());
        return parts.reduce(function (s, p) { return s + p.qty * p.price; }, 0);
      }

      function update() {
        var o = sel.options[sel.selectedIndex];
        if (!o || !o.dataset.price) { box.textContent = "Choose a system to see its price."; return; }
        var d = parseFloat(disc.value) || 0, sum = total();
        box.textContent = o.dataset.details + " — Total with extras " + inr(sum) + (d > 0 ? " − discount " + inr(d) + " = " + inr(Math.max(sum - d, 0)) : "");
      }

      // every part of the system and every extra with its price
      function showParts() {
        partsBox.innerHTML = "";
        var base = systemParts();
        if (!base) { partsBox.style.display = "none"; return; }
        var extra = extraParts();
        partsBox.style.display = "block";
        var table = document.createElement("table");
        var head = table.insertRow();
        ["Part", "Quantity", "Unit price", "Amount"].forEach(function (h, i) { var th = document.createElement("th"); th.textContent = h; if (i) th.className = "right"; head.appendChild(th); });
        var sum = 0;
        base.concat(extra).forEach(function (p, i) {
          var r = table.insertRow(), line = p.qty * p.price; sum += line;
          cell(r, p.name + (i >= base.length ? " (extra)" : "")); cell(r, p.qty + " " + p.unit, true); cell(r, inr(p.price), true); cell(r, inr(line), true);
        });
        if (!base.length && !extra.length) {
          var empty = table.insertRow(); var td = cell(empty, "The parts of this system are not listed yet – the admin can add them under Admin → Systems."); td.colSpan = 4;
        } else {
          var d = parseFloat(disc.value) || 0, t = table.insertRow();
          var label = cell(t, d > 0 ? "Total (after discount " + inr(d) + ")" : "Total", true); label.colSpan = 3; label.style.fontWeight = "700";
          var amount = cell(t, inr(Math.max(sum - d, 0)), true); amount.style.fontWeight = "700";
        }
        partsBox.appendChild(table);
      }

      function refresh() { update(); showParts(); }

      function fill(select, cat) {
        select.innerHTML = "";
        var blank = document.createElement("option");
        blank.value = ""; blank.textContent = "Select a part…";
        select.appendChild(blank);
        Object.keys(CATEGORIES).forEach(function (c) {
          if (cat && c !== cat) return;
          var ids = Object.keys(CATALOG).filter(function (id) { return CATALOG[id].cat === c; });
          if (!ids.length) return;
          var group = document.createElement("optgroup");
          group.label = CATEGORIES[c];
          ids.forEach(function (id) {
            var o = document.createElement("option");
            o.value = id;
            o.textContent = CATALOG[id].name + " — " + inr(CATALOG[id].price) + " / " + CATALOG[id].unit;
            group.appendChild(o);
          });
          select.appendChild(group);
        });
      }

      function addExtra(cat) {
        var tr = tpl.content.firstElementChild.cloneNode(true);
        var select = tr.querySelector(".extra-select");
        fill(select, cat);
        function row() {
          var item = CATALOG[select.value], qty = parseFloat(tr.querySelector(".extra-qty").value) || 0;
          tr.querySelector(".extra-price").textContent = item ? inr(item.price) : "—";
          tr.querySelector(".extra-line").textContent = item ? inr(item.price * qty) : "₹0";
          refresh();
        }
        select.addEventListener("change", row);
        tr.querySelector(".extra-qty").addEventListener("input", row);
        tr.querySelector(".extra-remove").addEventListener("click", function () {
          tr.remove();
          extrasBox.style.display = extrasBody.children.length ? "block" : "none";
          refresh();
        });
        extrasBody.appendChild(tr);
        extrasBox.style.display = "block";
        refresh();
      }

      document.querySelectorAll(".add-extra").forEach(function (b) {
        b.addEventListener("click", function () { addExtra(b.dataset.cat); });
      });
      sel.addEventListener("change", refresh);
      disc.addEventListener("input", refresh);
      refresh();
    })();
  </script>
<% end %>
