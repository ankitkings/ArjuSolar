<%# How the client paid: notes counted, cheque, UPI, bank transfer or card details %>
<% if receipt.mode == "cash" && receipt.details.present? %>
  <% lines = PaymentMethods.cash_lines(receipt.details) %>
  <p><strong>Cash received – notes counted</strong></p>
  <div class="table-wrap"><table>
    <tr><th>Note</th><th class="right">Count</th><th class="right">Amount</th></tr>
    <% lines.each do |value, count, amount| %>
      <tr><td>₹<%= value %></td><td class="right"><%= count %></td><td class="right"><%= inr(amount) %></td></tr>
    <% end %>
    <% if receipt.details["coins"].to_i.positive? %><tr><td>Coins</td><td class="right">—</td><td class="right"><%= inr(receipt.details["coins"]) %></td></tr><% end %>
    <tr><td colspan="2"><b>Cash counted</b></td><td class="right"><b><%= inr(receipt.details["counted_total"]) %></b></td></tr>
    <% if receipt.details["change_returned"].to_f.positive? %>
      <tr><td colspan="2">Change returned to the client</td><td class="right"><%= inr(receipt.details["change_returned"]) %></td></tr>
    <% end %>
  </table></div>
  <% if receipt.details["counted_by"] == "machine" %><p class="muted small">Counted by the money counting machine.</p><% end %>
<% else %>
  <% rows = PaymentMethods.rows(receipt.mode, receipt.details) %>
  <% if rows.any? %>
    <p><strong><%= receipt.mode_label %> details</strong></p>
    <div class="table-wrap"><table>
      <% rows.each do |label, value| %><tr><td><%= label %></td><td><%= value %></td></tr><% end %>
    </table></div>
  <% end %>
<% end %>
