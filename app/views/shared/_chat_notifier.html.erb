<%# Alerts for new chat messages on every page: pop-up, sound, tab title, optional desktop notification %>
<div id="chat-toasts" class="chat-toasts" aria-live="polite"></div>
<script>
  (function () {
    var URL = "<%= url %>";
    var KEY = "chatSeen:<%= user_key %>";      // newest message this browser has already told the person about
    var badge = document.getElementById("chat-badge");
    var baseTitle = document.title;

    function soundOn() { return localStorage.getItem("chatSound") !== "off"; }

    function beep() {
      if (!soundOn()) return;
      try {
        var Ctx = window.AudioContext || window.webkitAudioContext;
        if (!Ctx) return;
        var ctx = new Ctx(), osc = ctx.createOscillator(), gain = ctx.createGain();
        osc.type = "sine"; osc.frequency.value = 880; gain.gain.value = 0.08;
        osc.connect(gain); gain.connect(ctx.destination);
        osc.start(); osc.stop(ctx.currentTime + 0.15);
        setTimeout(function () { ctx.close(); }, 500);
      } catch (e) {}
    }

    function heading(m) { return m.group ? m.sender + " in " + m.group : m.sender; }

    function toast(m) {
      var box = document.getElementById("chat-toasts");
      var a = document.createElement("a");
      a.className = "chat-toast"; a.href = m.url;
      var title = document.createElement("b"); title.textContent = heading(m);
      var text = document.createElement("span"); text.textContent = m.preview;
      a.appendChild(title); a.appendChild(text);
      box.appendChild(a);
      setTimeout(function () { a.remove(); }, 8000);
    }

    // desktop notification, only while this tab is in the background
    function desktop(m) {
      if (!document.hidden || !("Notification" in window) || Notification.permission !== "granted") return;
      var n = new Notification(heading(m), { body: m.preview, tag: "chat-" + m.chat_id });
      n.onclick = function () { window.focus(); window.location = m.url; n.close(); };
    }

    function check() {
      var seen = localStorage.getItem(KEY);
      fetch(URL + (seen ? "?after=" + encodeURIComponent(seen) : ""), { headers: { "Accept": "application/json" }, credentials: "same-origin" })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d) return;
          var marker = document.getElementById("chat-open");          // the chat this person is looking at right now
          var openId = marker ? parseInt(marker.dataset.chatId, 10) : null;
          var fresh = d.messages.filter(function (m) { return !(m.chat_id === openId && !document.hidden); });
          fresh.forEach(function (m) { toast(m); desktop(m); });
          if (fresh.length) beep();
          localStorage.setItem(KEY, String(d.latest));
          if (badge) { badge.textContent = d.unread; badge.style.display = d.unread > 0 ? "inline" : "none"; }
          document.title = d.unread > 0 ? "💬" + d.unread + " " + baseTitle : baseTitle;
        })
        .catch(function () {});
    }

    // chat page: sound switch + button to allow desktop alerts
    var enable = document.getElementById("enable-alerts");
    if (enable && "Notification" in window && Notification.permission === "default") {
      enable.style.display = "inline-block";
      enable.addEventListener("click", function () {
        Notification.requestPermission().then(function () { enable.style.display = "none"; });
      });
    }
    var soundBox = document.getElementById("chat-sound");
    if (soundBox) {
      soundBox.checked = soundOn();
      soundBox.addEventListener("change", function () { localStorage.setItem("chatSound", soundBox.checked ? "on" : "off"); });
    }

    check();
    setInterval(check, 5000);
  })();
</script>
