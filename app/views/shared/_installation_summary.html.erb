<h3>Installed system</h3>
<% if installation.solar_package %><p><strong>System:</strong> <%= installation.solar_package.name %></p><% end %>
<p><strong>Installed on:</strong> <%= l installation.installed_on, format: :long %></p>
<p><strong>Capacity:</strong> <%= installation.capacity_kw.to_f %> kW</p>
<% if installation.package_price %><p><strong>System price:</strong> <%= inr(installation.package_price) %></p><% end %>
<p><strong>Panels:</strong> <%= installation.panel_count || "—" %><%= " × #{installation.panel_brand}" if installation.panel_brand.present? %></p>
<p><strong>Inverter:</strong> <%= installation.inverter_model.presence || "—" %></p>
<p><strong>Site address:</strong> <%= installation.site_address.presence || "—" %></p>
<% if installation.notes.present? %><p><strong>Notes:</strong> <%= installation.notes %></p><% end %>
<% saved_photos = installation.photos.select(&:persisted?) %>
<% if saved_photos.any? %>
  <div class="thumbs-row">
    <% saved_photos.each do |photo| %>
      <%= link_to image_tag(url_for(photo), alt: "Site photo", loading: "lazy"), url_for(photo), target: "_blank", rel: "noopener" %>
    <% end %>
  </div>
<% end %>
