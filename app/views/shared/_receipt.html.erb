<% pay = receipt.payment %>
<% req = pay.service_request %>
<% inst = req.installation %>
<div class="receipt">
  <div class="receipt-head">
    <div>
      <h2><%= site_setting.company_name %></h2>
      <% if (office = site_contacts("address").first) %><p><%= office.value %></p><% end %>
      <% if site_phone %><p><%= site_phone %></p><% end %>
    </div>
    <div class="right">
      <h3>RECEIPT</h3>
      <p><b><%= receipt.number %></b></p>
      <p>Date: <%= l receipt.received_on, format: :long %></p>
    </div>
  </div>
  <hr>
  <p><strong>Received from:</strong> <%= req.name %> · <%= req.phone %></p>
  <% if req.address.present? %><p><strong>Address:</strong> <%= req.address %></p><% end %>
  <p><strong>Against:</strong> Solar installation, request #<%= req.id %>
    <% if inst %>— <%= inst.solar_package&.name || inst.summary %> (<%= format("%g", inst.capacity_kw.to_f) %> kW)<% end %></p>

  <div class="table-wrap"><table>
    <tr><th>Description</th><th class="right">Amount</th></tr>
    <tr>
      <td>Payment received by <%= receipt.mode_label %><%= " · Ref: #{receipt.reference}" if receipt.reference.present? %></td>
      <td class="right"><b><%= inr(receipt.amount) %></b></td>
    </tr>
    <tr><td>Total amount due</td><td class="right"><%= inr(pay.amount_due) %></td></tr>
    <tr><td>Total received up to this receipt</td><td class="right"><%= inr(receipt.paid_to_date) %></td></tr>
    <tr><td><b>Balance after this receipt</b></td><td class="right"><b><%= inr(receipt.balance_after) %></b></td></tr>
  </table></div>

  <%= render "shared/receipt_details", receipt: receipt %>

  <% if receipt.note.present? %><p><strong>Note:</strong> <%= receipt.note %></p><% end %>
  <p><strong>Received by:</strong> <%= receipt.team_member&.name || "—" %> (Cashier)</p>
  <% if receipt.mode == "cheque" && receipt.clearing_status.present? %>
    <p class="small"><b>Cheque status:</b> <%= receipt.clearing_label %><%= " on #{l receipt.cleared_on, format: '%d %b %Y'}" if receipt.cleared_on %><%= " (#{receipt.clearing_note})" if receipt.clearing_note.present? %>.
      <%= "This amount counts as paid only after the bank has received the cheque." if receipt.waiting_for_bank? %></p>
  <% end %>
  <p class="no-print"><%= link_to "🧾 View the bill", (controller_path.start_with?("admin") ? admin_payment_bill_path(pay) : staff_payment_bill_path(pay)) %></p>
  <p class="muted small">This is a computer-generated receipt.</p>
</div>
