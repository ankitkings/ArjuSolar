<% if installation.errors.any? %><div class="flash alert"><%= installation.errors.full_messages.to_sentence %></div><% end %>
<%= form_with model: installation, url: url, method: :post, class: "form" do |f| %>
  <%= f.label :installed_on, "Installation date" %><%= f.date_field :installed_on, required: true, max: Date.current %>
  <%= f.label :capacity_kw, "System capacity (kW)" %><%= f.number_field :capacity_kw, step: 0.01, min: 0.1, required: true %>
  <%= f.label :panel_count, "Number of panels" %><%= f.number_field :panel_count, min: 1 %>
  <%= f.label :panel_brand, "Panel brand / model" %><%= f.text_field :panel_brand %>
  <%= f.label :inverter_model, "Inverter model" %><%= f.text_field :inverter_model %>
  <%= f.label :site_address, "Site address" %><%= f.text_area :site_address, rows: 2 %>
  <%= f.label :notes, "Notes" %><%= f.text_area :notes, rows: 2 %>
  <%= f.submit "Installation done → complete request", class: "btn go" %>
<% end %>
