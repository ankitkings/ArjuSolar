<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for?(:title) ? "#{yield(:title)} — Arju Solars" : "Arju Solars — Powering Your Future" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <%= stylesheet_link_tag "application" %>
</head>
<body>
  <header class="site-header"><div class="wrap">
    <%= link_to "Arju Solars", root_path, class: "brand" %>
    <nav>
      <%= link_to "Home", root_path %><%= link_to "About", about_path %><%= link_to "Services", services_path %>
      <%= link_to "Projects", projects_path %><%= link_to "Our Team", team_path %><%= link_to "Contact", contact_path %>
    </nav>
  </div></header>
  <% flash.each do |type, msg| %><div class="flash <%= type %>"><%= msg %></div><% end %>
  <main><%= yield %></main>
  <footer class="site-footer"><div class="wrap">
    <h4>Arju Solars</h4>
    <p>Powering Central India — Installation | Service | Maintenance</p>
    <p><strong>Phone:</strong> <%= link_to "+91 7049465926", "tel:+917049465926" %></p>
    <p><strong>Email:</strong> ankitparmar5035582@gmail.com</p>
    <p><strong>Address:</strong> Indore, Madhya Pradesh, India</p>
    <p><%= link_to "WhatsApp", "https://wa.me/917049465926", target: "_blank", rel: "noopener noreferrer" %> ·
       <%= current_admin ? link_to("Admin Panel", admin_root_path) : link_to("Admin", admin_login_path) %> ·
       <%= link_to "Staff", (current_staff ? staff_root_path : staff_login_path) %></p>
    <p class="small">We record anonymous visit data (IP address, browser, pages viewed) to improve our service.</p>
  </div></footer>
</body>
</html>
