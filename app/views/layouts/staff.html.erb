<!DOCTYPE html>
<html lang="en">
<head>
  <title>Staff — Arju Solars</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <%= stylesheet_link_tag "application" %>
</head>
<body class="admin">
  <aside>
    <h3>Arju Solars</h3>
    <p style="color:#e2e8f0;margin:0"><b><%= current_staff.name %></b></p>
    <p style="color:#94a3b8;margin:0 0 12px;font-size:.85rem"><%= current_staff.department_label %></p>
    <%= link_to "My tasks", staff_root_path %>
    <%= link_to "View site", root_path %>
    <%= button_to "Log out", staff_logout_path, method: :delete, class: "linklike" %>
  </aside>
  <main class="admin-main">
    <% flash.each do |type, msg| %><div class="flash <%= type %>"><%= msg %></div><% end %>
    <%= yield %>
  </main>
</body>
</html>
