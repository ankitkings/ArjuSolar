<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= "(#{new_request_count}) " if new_request_count.positive? %>Admin — Arju Solars</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <%= stylesheet_link_tag "application" %>
  <style>
    .app-bar,.drawer-backdrop{display:none}
    @media(max-width:900px){.app-bar{display:flex}}
    @media(min-width:901px){.app-bar,.drawer-backdrop{display:none !important}}
  </style>
</head>
<body class="admin">
  <header class="app-bar">
    <button type="button" class="menu-toggle" aria-label="Menu" aria-expanded="false">☰</button>
    <span class="app-title">Arju Solars</span>
    <% if new_request_count.positive? %><span class="nav-badge"><%= new_request_count %> new</span><% end %>
  </header>
  <div class="drawer-backdrop"></div>
  <aside>
    <h3>Arju Solars</h3>
    <%= link_to admin_root_path do %>Dashboard<% if overdue_count.positive? %><span class="nav-badge"><%= overdue_count %></span><% end %><% end %>
    <%= link_to admin_my_tasks_path do %>My tasks<span class="nav-badge" id="my-tasks-badge" style="<%= 'display:none' unless new_task_count.positive? %>"><%= new_task_count %> new</span><% end %>
    <%= link_to admin_service_requests_path do %>Requests<%= module_badge("requests") %><% end %>
    <%= link_to admin_users_path do %>Users<%= module_badge("users") %><% end %>
    <%= link_to admin_visits_path do %>Visitors<%= module_badge("visitors") %><% end %>
    <%= link_to admin_payments_path do %>Payments<%= module_badge("payments") %><% end %>
    <%= link_to "Payment setup", admin_payment_settings_path %>
    <%= link_to admin_maintenance_visits_path do %>Maintenance<%= module_badge("maintenance") %><% end %>
    <%= link_to admin_solar_packages_path do %>Systems<%= module_badge("systems") %><% end %>
    <%= link_to admin_catalog_items_path do %>Parts<%= module_badge("parts") %><% end %>
    <%= link_to "Margins", admin_margins_path %>
    <%= link_to admin_stock_path do %>Stock<% if parts_short_count.positive? %><span class="nav-badge"><%= parts_short_count %></span><% end %><% end %>
    <%= link_to admin_subsidy_applications_path do %>Subsidy<%= module_badge("subsidy") %><% end %>
    <%= link_to "Website", admin_website_path %>
    <%= link_to admin_customers_path do %>Clients<%= module_badge("clients") %><% end %>
    <%= link_to admin_team_members_path do %>Team<%= module_badge("team") %><% end %>
    <%= link_to admin_attendance_path do %>Attendance<%= module_badge("attendance") %><% end %>
    <%= link_to "Holidays", admin_holidays_path %>
    <%= link_to admin_leave_requests_path(status: "pending") do %>Leaves<% if pending_leave_count.positive? %><span class="nav-badge"><%= pending_leave_count %></span><% end %><% end %>
    <%= link_to "Payroll", admin_payroll_path %>
    <%= link_to admin_salary_payments_path do %>Salary records<%= module_badge("salary") %><% end %>
    <%= link_to admin_chats_path do %>Chat<span class="nav-badge" id="chat-badge" style="<%= 'display:none' unless chat_unread_count(current_admin).positive? %>"><%= chat_unread_count(current_admin) %></span><% end %>
    <%= link_to "View site", root_path %>
    <%= button_to "Log out", admin_logout_path, method: :delete, class: "linklike" %>
  </aside>
  <main class="admin-main">
    <% flash.each do |type, msg| %><div class="flash <%= type %>"><%= msg %></div><% end %>
    <%= yield %>
  </main>
  <%= render "shared/chat_notifier", url: notifications_admin_chats_path, user_key: "admin:#{current_admin.id}" %>
  <%= render "shared/responsive" %>
  <%= render "shared/admin_task_alert" %>
</body>
</html>
