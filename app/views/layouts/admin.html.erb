<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= "(#{new_request_count}) " if new_request_count.positive? %>Admin — Arju Solars</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <%= stylesheet_link_tag "application" %>
</head>
<body class="admin">
  <aside>
    <h3>Arju Solars</h3>
    <%= link_to "Dashboard", admin_root_path %>
    <%= link_to admin_service_requests_path do %>Requests<% if new_request_count.positive? %><span class="nav-badge"><%= new_request_count %></span><% end %><% end %>
    <%= link_to "Users", admin_users_path %>
    <%= link_to "Visitors", admin_visits_path %>
    <%= link_to "Payments", admin_payments_path %>
    <%= link_to "Maintenance", admin_maintenance_visits_path %>
    <%= link_to "Systems", admin_solar_packages_path %>
    <%= link_to "Parts", admin_catalog_items_path %>
    <%= link_to "Subsidy", admin_subsidy_applications_path %>
    <%= link_to "Team", admin_team_members_path %>
    <%= link_to admin_chats_path do %>Chat<span class="nav-badge" id="chat-badge" style="<%= 'display:none' unless chat_unread_count(current_admin).positive? %>"><%= chat_unread_count(current_admin) %></span><% end %>
    <%= link_to "View site", root_path %>
    <%= button_to "Log out", admin_logout_path, method: :delete, class: "linklike" %>
  </aside>
  <main class="admin-main">
    <% flash.each do |type, msg| %><div class="flash <%= type %>"><%= msg %></div><% end %>
    <%= yield %>
  </main>
  <%= render "shared/chat_notifier", url: notifications_admin_chats_path, user_key: "admin:#{current_admin.id}" %>
</body>
</html>
