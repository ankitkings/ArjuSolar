<section class="wrap narrow"><h1>Admin Login</h1>
  <%= form_with url: admin_login_path, class: "form" do %>
    <%= label_tag :email %><%= email_field_tag :email, nil, required: true, autofocus: true %>
    <%= label_tag :password %><%= password_field_tag :password, nil, required: true %>
    <%= submit_tag "Log in", class: "btn" %>
  <% end %>
</section>
