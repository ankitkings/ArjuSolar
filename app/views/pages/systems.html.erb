<section class="wrap"><h1>Our Solar Systems</h1>
  <p>Ready-to-install packages for homes and businesses. Every system includes installation, start-up and scheduled maintenance checks.</p>
  <% if @packages.any? %>
    <div class="grid"><% @packages.each do |package| %><%= render "pages/system_card", package: package %><% end %></div>
  <% else %>
    <p class="muted">Our system packages will be listed here soon. <%= link_to "Contact us", contact_path %> for a quotation.</p>
  <% end %>
  <p class="muted small" style="margin-top:16px">Prices are package prices; the final quotation is prepared after a free site visit.</p>
</section>
