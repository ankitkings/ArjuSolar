<section class="wrap"><h1>Our Projects</h1>
  <p>Real installations completed by our team, with photos taken on site.</p>
  <% if @projects.any? %>
    <div class="grid"><% @projects.each do |project| %><%= render "pages/project_card", project: project %><% end %></div>
  <% else %>
    <p class="muted">Photos of our completed installations will appear here. <%= link_to "Get your own solar system", contact_path %>.</p>
  <% end %>
</section>
