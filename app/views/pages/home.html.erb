<section class="hero"><div class="wrap">
  <h1>Powering Your Future</h1>
  <p>Affordable, clean &amp; efficient solar energy solutions for homes &amp; businesses.</p>
  <%= link_to "Get a Free Quote", contact_path, class: "btn" %>
</div></section>

<section class="wrap">
  <h2>Why Choose Arju Solars</h2>
  <div class="grid">
    <div class="card"><h4>High Efficiency Panels</h4><p>We install premium-grade solar panels with proven performance and warranties.</p></div>
    <div class="card"><h4>Professional Installation</h4><p>Certified technicians and safe, timely installations with full documentation.</p></div>
    <div class="card"><h4>Service &amp; Support</h4><p>AMC, monitoring and fast on-site support to keep your system optimal.</p></div>
  </div>
</section>

<section class="wrap">
  <h2>How it works</h2>
  <div class="steps">
    <div class="step"><b>1</b><h4>Free consultation</h4><p>Tell us about your home or business. Our contact person calls you.</p></div>
    <div class="step"><b>2</b><h4>Site visit &amp; quote</h4><p>We inspect your roof and give you a clear quotation.</p></div>
    <div class="step"><b>3</b><h4>Installation</h4><p>Our installation team fits your system safely and on time.</p></div>
    <div class="step"><b>4</b><h4>Start-up</h4><p>After payment, our servicing team starts your panels and gives the final touch.</p></div>
    <div class="step"><b>5</b><h4>Care</h4><p>Maintenance checks after 15 days and 2 months, and servicing whenever you need it.</p></div>
  </div>
</section>

<% if @packages.any? %>
  <section class="wrap">
    <h2>Our Systems <%= link_to "See all systems", systems_path, class: "small-link" %></h2>
    <div class="grid"><% @packages.each do |package| %><%= render "pages/system_card", package: package %><% end %></div>
  </section>
<% end %>

<section class="wrap">
  <h2>Our Services <%= link_to "See all services", services_path, class: "small-link" %></h2>
  <%= render "pages/service_cards" %>
</section>

<% if @projects.any? %>
  <section class="wrap">
    <h2>Recent Projects <%= link_to "See all projects", projects_path, class: "small-link" %></h2>
    <div class="grid"><% @projects.each do |project| %><%= render "pages/project_card", project: project %><% end %></div>
  </section>
<% end %>

<section class="cta"><div class="wrap">
  <h2>Ready to go solar?</h2>
  <p>Call us or send a WhatsApp message for a site visit &amp; free estimate.</p>
  <%= link_to "Call +91 7049465926", "tel:+917049465926", class: "btn" %>
  <%= link_to "WhatsApp", "https://wa.me/917049465926", class: "btn alt", target: "_blank", rel: "noopener noreferrer" %>
</div></section>
