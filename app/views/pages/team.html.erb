<% content_for(:title, "Our team") %>
<section class="s-page-hero"><div class="s-wrap"><h1>Our Team</h1><p>The people who make your solar journey smooth, from the first call to daily servicing.</p></div></section>

<section class="s-section">
  <div class="s-wrap">
    <% shown = false %>
    <% TeamMember::DEPARTMENTS.each do |key, label| %>
      <% members = @groups[key] %>
      <% next if members.blank? %>
      <% shown = true %>
      <div class="s-head reveal" id="<%= key %>" style="margin-bottom:22px"><span class="s-eyebrow"><%= label %></span></div>
      <div class="s-grid c4" style="margin-bottom:44px">
        <% members.each do |m| %>
          <div class="s-card s-person reveal">
            <div class="s-avatar"><%= m.name[0] %></div>
            <span class="role"><%= label %></span>
            <h3><%= m.name %></h3>
            <% if m.bio.present? %><p><%= m.bio %></p><% end %>
            <% if m.phone.present? %><p style="margin-top:10px"><%= link_to m.phone, "tel:#{m.phone.gsub(/[^\d+]/, '')}" %></p><% end %>
          </div>
        <% end %>
      </div>
    <% end %>
    <% unless shown %><div class="s-card"><p>Our team will be introduced here soon.</p></div><% end %>
  </div>
</section>
