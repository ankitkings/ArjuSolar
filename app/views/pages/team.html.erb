<section class="wrap"><h1>Our Team</h1>
  <p>The people who make your solar journey smooth — from first call to daily servicing.</p>
  <% TeamMember::DEPARTMENTS.each do |key, label| %>
    <% members = @groups[key] %>
    <% next if members.blank? %>
    <h2 id="<%= key %>"><%= label %></h2>
    <div class="grid">
      <% members.each do |m| %>
        <div class="card">
          <div class="avatar"><%= m.name[0] %></div>
          <h4><%= m.name %></h4>
          <p class="muted"><%= label %></p>
          <p><%= m.bio %></p>
          <% if m.phone.present? %><p><%= link_to m.phone, "tel:#{m.phone.gsub(/[^\d+]/, '')}" %></p><% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
