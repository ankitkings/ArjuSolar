<% photos = project.photos.to_a.first(3) %>
<div class="s-card s-proj reveal">
  <div class="main-photo"><%= image_tag url_for(photos.first), alt: "Solar installation #{project.public_location}", loading: "lazy" %><span class="s-kw">⚡ <%= format("%g", project.capacity_kw.to_f) %> kW</span></div>
  <% if photos.size > 1 %>
    <div class="thumbs"><% photos.drop(1).each do |photo| %><%= image_tag url_for(photo), alt: "Installation site photo", loading: "lazy" %><% end %></div>
  <% end %>
  <div class="body">
    <h4><%= format("%g", project.capacity_kw.to_f) %> kW solar system</h4>
    <p class="meta">📍 <%= project.public_location.presence || "Indore" %> · <%= l project.installed_on, format: "%B %Y" %></p>
    <p class="meta"><%= [project.panel_count && "#{project.panel_count} panels", project.panel_brand].compact.join(" · ") %></p>
  </div>
</div>
