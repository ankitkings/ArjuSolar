<% services = [
  ["Residential Rooftop Solar", SiteImages::RESIDENTIAL, "Rooftop solar for homes and shops – from roof inspection and system sizing to installation. Subsidy assistance included."],
  ["Commercial & Industrial", SiteImages::COMMERCIAL, "Scalable solar projects for businesses, with performance contracts and monitoring."],
  ["Installation & Commissioning", SiteImages::INSTALLATION, "Certified technicians and safe, timely installations with full documentation. Our servicing team starts your system and gives the final touch."],
  ["Maintenance & AMC", SiteImages::MAINTENANCE, "Scheduled maintenance, cleaning and performance checks to keep your system running for years."]
] %>
<div class="grid">
  <% services.each do |title, image, text| %>
    <div class="card">
      <%= image_tag image, alt: title, loading: "lazy" %>
      <h4><%= title %></h4>
      <p><%= text %></p>
    </div>
  <% end %>
</div>
