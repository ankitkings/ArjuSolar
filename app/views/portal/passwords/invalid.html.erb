<% content_for(:title, "Link expired") %>
<%= render "portal/shared/styles" %>
<div class="pt pt-narrow">
  <div class="pt-card">
    <h1>This link does not work any more</h1>
    <p>The link has expired or was already used. You can ask for a new one.</p>
    <p><%= link_to "Get a new link", portal_forgot_password_path, class: "pt-btn blue" %></p>
  </div>
</div>
