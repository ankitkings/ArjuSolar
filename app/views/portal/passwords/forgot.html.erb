<% content_for(:title, "Forgot password") %>
<%= render "portal/shared/styles" %>
<div class="pt pt-narrow">
  <div class="pt-card">
    <h1>Forgot your password?</h1>
    <p class="pt-muted">Type your registered e-mail address. We will send a link to choose a new password.</p>
    <%= form_with url: portal_forgot_password_path, method: :post, class: "form" do %>
      <%= label_tag :email, "E-mail address" %><%= email_field_tag :email, nil, required: true, autocomplete: "email" %>
      <%= submit_tag "E-mail me the link", class: "btn" %>
    <% end %>
    <p class="pt-muted"><%= link_to "Back to login", portal_login_path %></p>
  </div>
</div>
