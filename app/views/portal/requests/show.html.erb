      <% end %>

      <% if @issues.any? %>
        <h4>Earlier issues</h4>
        <table>
          <tr><th>Reported</th><th>Problem</th><th>Visit</th></tr>
          <% @issues.each do |v| %>
            <tr>
              <td><%= l v.created_at, format: "%d %b %Y" %></td>
              <td><%= v.issue_details.to_s.truncate(120) %></td>
              <td>
                <% if v.status == "done" %><span class="pt-chip green">Visit done</span>
                <% elsif v.status == "assigned" %><span class="pt-chip blue">Engineer assigned<%= " – #{v.team_member.name}" if v.team_member %></span>
                <% else %><span class="pt-chip amber">Asked for <%= l v.due_on, format: "%d %b" %></span><% end %>
