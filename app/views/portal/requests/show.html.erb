<% r = @service_request %>
<% content_for(:title, "Request ##{r.id}") %>
<%= render "portal/shared/styles" %>
<div class="pt">
  <%= render "portal/shared/nav" %>
  <p><%= link_to "← My portal", portal_root_path %></p>
  <h1>Request #<%= r.id %> <span class="pt-chip <%= r.status == 'cancelled' ? 'red' : (r.status == 'completed' ? 'green' : 'blue') %>"><%= r.status == "cancelled" ? "Closed" : PortalStatus.title(r.status) %></span></h1>
  <p class="pt-muted">Sent on <%= l r.created_at, format: "%d %b %Y" %> · <%= r.address %></p>

