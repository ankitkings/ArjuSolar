<style>
  .pt{max-width:1040px;margin:0 auto;padding:22px 16px 40px;color:#0f172a}
  .pt h1,.pt h2,.pt h3{letter-spacing:-.01em}
  .pt-nav{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:16px;background:#e2e8f0;padding:5px;border-radius:14px}
  .pt-nav a,.pt-nav button{padding:8px 14px;border-radius:10px;color:#334155;font-weight:600;text-decoration:none;background:transparent;border:0;cursor:pointer;font:inherit;font-weight:600}
  .pt-nav a:hover,.pt-nav button:hover{background:rgba(255,255,255,.75)}
  .pt-nav .spacer{flex:1}
  .pt-nav form{margin:0}
  .pt-hero{position:relative;overflow:hidden;border-radius:20px;padding:24px 26px;margin-bottom:18px;color:#fff;background:linear-gradient(120deg,#0b1224 0%,#16327a 55%,#2563eb 100%);box-shadow:0 12px 30px rgba(37,99,235,.25)}
  .pt-hero::after{content:"";position:absolute;right:-60px;top:-70px;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,#fff7c2 0%,#fbbf24 28%,rgba(245,158,11,.35) 52%,rgba(245,158,11,0) 70%)}
  .pt-hero>*{position:relative;z-index:1}.pt-hero h1{margin:0 0 4px;font-size:1.7rem}.pt-hero p{margin:0 0 14px;color:#cbd5e1}
  .pt-btn{display:inline-block;padding:10px 18px;border-radius:99px;font-weight:700;text-decoration:none;color:#0f172a;background:#fbbf24;border:0;cursor:pointer;font:inherit;font-weight:700}
  .pt-btn.blue{background:linear-gradient(135deg,#3b82f6,#1d4ed8);color:#fff}
  .pt-btn:hover{filter:brightness(1.06)}
  .pt-card{background:#fff;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,42,.06),0 8px 24px rgba(15,23,42,.06);padding:18px 20px;margin-bottom:16px}
  .pt-card h2,.pt-card h3{margin-top:0}
  .pt-grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(290px,1fr))}
  .pt-chip{display:inline-block;padding:3px 11px;border-radius:99px;font-size:.78rem;font-weight:700;background:#e2e8f0;color:#334155}
  .pt-chip.green{background:#dcfce7;color:#166534}.pt-chip.blue{background:#dbeafe;color:#1d4ed8}.pt-chip.amber{background:#fef3c7;color:#92400e}.pt-chip.red{background:#fee2e2;color:#b91c1c}
  .pt-bar{height:10px;border-radius:99px;background:#e2e8f0;overflow:hidden;margin:10px 0}
  .pt-bar i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,#3b82f6,#22c55e)}
  .pt-muted{color:#64748b;font-size:.9rem}
  .pt-steps{list-style:none;margin:0;padding:0}
  .pt-steps li{display:flex;gap:14px;padding:0 0 18px;position:relative}
  .pt-steps li:not(:last-child)::before{content:"";position:absolute;left:15px;top:32px;bottom:0;width:2px;background:#e2e8f0}
  .pt-steps li.done:not(:last-child)::before{background:#22c55e}
  .pt-dot{flex:none;width:32px;height:32px;border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:.85rem;background:#e2e8f0;color:#64748b}
  .pt-steps li.done .pt-dot{background:#22c55e;color:#fff}
  .pt-steps li.now .pt-dot{background:#2563eb;color:#fff;box-shadow:0 0 0 6px rgba(37,99,235,.18)}
  .pt-steps b{display:block}.pt-steps small{color:#64748b}
  .pt-steps li.todo b{color:#94a3b8}
  .pt-narrow{max-width:520px;margin:30px auto}
  .pt-narrow .pt-card{padding:24px}
  .pt .form input,.pt .form select,.pt .form textarea{width:100%}
  .pt-error{background:#fee2e2;color:#991b1b;border-left:5px solid #ef4444;border-radius:10px;padding:10px 14px;margin:0 0 12px;font-weight:600}
  .pt-ok{background:#dcfce7;color:#166534;border-left:5px solid #22c55e;border-radius:10px;padding:10px 14px;margin:0 0 12px;font-weight:600}
  .pt table{width:100%;border-collapse:collapse}.pt th,.pt td{padding:10px 8px;text-align:left;border-bottom:1px solid #f1f5f9}.pt th{color:#64748b;font-size:.78rem;text-transform:uppercase}
</style>
