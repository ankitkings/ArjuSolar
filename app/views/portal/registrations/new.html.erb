<% content_for(:title, "Register") %>
<%= render "portal/shared/styles" %>
<div class="pt pt-narrow">
  <div class="pt-card">
    <h1>Create your client account</h1>
    <p class="pt-muted">Register with your e-mail address. We will e-mail you a link to choose a password. With your account you can request a solar installation, follow its progress and ask for a visit if something is wrong during the warranty.</p>
    <% if @customer.errors.any? %><div class="pt-error"><%= @customer.errors.full_messages.to_sentence %></div><% end %>
    <%= form_with model: @customer, url: portal_register_path, method: :post, class: "form" do |f| %>
      <%= text_field_tag :website, nil, style: "display:none", tabindex: -1, autocomplete: "off" %>
      <%= f.label :name, "Your name" %><%= f.text_field :name, required: true, maxlength: 100 %>
      <%= f.label :email, "E-mail address (this will be your login)" %><%= f.email_field :email, required: true, autocomplete: "email" %>
      <%= f.label :phone, "Mobile number" %><%= f.telephone_field :phone, required: true, placeholder: "+91 98765 43210" %>
      <%= f.submit "Register and e-mail me the link", class: "btn" %>
    <% end %>
    <p class="pt-muted">Already registered? <%= link_to "Log in", portal_login_path %></p>
  </div>
</div>
